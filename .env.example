# Token Bot Telegram dari @BotFather
BOT_TOKEN=1234567890:AAF_contoh_token_bot_anda

# Username Docker Hub Anda (untuk pull image pre-built)
DOCKERHUB_USERNAME=fitra17

# URL HTTPS publik tempat Mini App di-host (wajib HTTPS untuk Telegram Mini App)
WEBAPP_URL=https://browser.fitra.bot.cd

# Port server Express (Mini App + API + noVNC Proxy) — Port 3003 (3001 & 3002 sudah dipakai bot lain)
PORT=3003

# MongoDB URI — pilih salah satu:
# 1) MongoDB Lokal / Podman Compose:
MONGODB_URI=mongodb://mongo:27017/remote_browser
# 2) MongoDB Cloud Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/remote_browser?retryWrites=true&w=majority

# Direktori penyimpanan profil Chromium persisten (cookie, login session)
BROWSER_PROFILES_DIR=/data/profiles

# Opsional: batasi akses hanya untuk Telegram User ID tertentu (pisahkan dengan koma)
ALLOWED_TELEGRAM_IDS=

# Display X11 virtual untuk Chromium headed mode
DISPLAY=:99
